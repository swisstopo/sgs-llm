# Template for infra/dev-access.local.env — which is git-ignored and NEVER committed.
#
# The developer access role (`sgs-llm-dev`) grants Bedrock inference and
# read-only access to the feedback / conversation tables, but only for requests
# coming from this network. Keeping the address out of the public repository is
# the reason this file exists: copy it, fill in the real value locally, and let
# the deploy command read it from the environment.
#
#   cp infra/dev-access.env.example infra/dev-access.local.env
#   # edit infra/dev-access.local.env
#   source infra/dev-access.local.env
#
# Then deploy with:
#   ... --parameter-overrides DevAccessCidr="$DEV_ACCESS_CIDR" ...
#
# Leaving DEV_ACCESS_CIDR empty is valid: the role is simply not created.

# Fixed egress address of the office / VPN, as a CIDR (a single host is /32).
DEV_ACCESS_CIDR=203.0.113.10/32
